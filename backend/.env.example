# Application
DEBUG=false
ENVIRONMENT=production

# Database (PostgreSQL)
# Локально: docker compose up -d postgres redis
# Порт 5433 на хосте (внутри Docker — postgres:5432)
DATABASE_URL=postgresql+asyncpg://graph:graph@localhost:5433/graph

# Redis
REDIS_URL=redis://localhost:6379/0

# Telegram
BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=your_telegram_api_hash
PREMIUM_CHANNEL_ID=-1001234567890

# Mini App URL (для кнопки в боте, nginx)
WEB_APP_URL=https://pushes.su

# JWT — сгенерируйте длинный случайный ключ (32+ символов)
JWT_SECRET=replace-with-long-random-secret

# Proxies (Webshare, опционально)
WEBSHARE_PROXIES=

# VK
VK_ACCESS_TOKEN=

# CORS (ваш домен фронта)
CORS_ORIGINS=https://your-domain.com

DEFAULT_CITY=moscow
FREE_DAILY_NOTIFICATIONS=5
FREE_MAX_SEARCHES=3
